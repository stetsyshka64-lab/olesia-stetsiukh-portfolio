---
// Перший екран головної сторінки. Макет: Figma → Portfolio → node 22:1223 (1920×1080).
import { Image } from 'astro:assets';
import Header from './Header.astro';
import portrait from '../assets/portrait.png';
import { socials } from '../data/contacts';

const processSteps = [
  'UI/UX',
  'Research',
  'User flow',
  'CJM',
  'Wireframe',
  'Adaptive design',
  'Prototyping',
];
---

<section class="first-screen">
  <div class="first-screen__bg" aria-hidden="true">
    <img class="bg-ellipse bg-ellipse--left" src="/figma/ellipse-left.svg" alt="" />
    <img class="bg-ellipse bg-ellipse--top" src="/figma/ellipse-top.svg" alt="" />
    <img class="bg-ellipse bg-ellipse--right" src="/figma/ellipse-right.svg" alt="" />
  </div>

  <Header />

  <div class="hero">
    <div class="hero__intro">
      <div class="hero__copy">
        <p class="hero__eyebrow">UI-дизайнерка · Figma</p>
        <h1 class="hero__title">Від ідеї<br />до екранів<br />разом.</h1>
        <p class="hero__lead">
          Допоможу стартапам і малому бізнесу пройти шлях від ідеї до готових UI-екранів у Figma —<br
            class="lead-br"
          /> разом, крок за кроком.
        </p>
      </div>
      <div class="hero__actions">
        <a class="btn btn--dark" href="#works">
          Переглянути роботи
          <img class="btn__icon" src="/figma/arrow-right.svg" alt="" width="32" height="32" />
        </a>
        <a class="btn" href="#contacts">
          Написати мені
          <img class="btn__icon" src="/figma/arrow-right.svg" alt="" width="32" height="32" />
        </a>
      </div>
    </div>

    <div class="hero__art-col">
      <div class="art">
        <img class="art__circle" src="/figma/ellipse-portrait.svg" alt="" aria-hidden="true" />
        <Image
          class="art__portrait"
          src={portrait}
          alt="Олеся Стецюх"
          widths={[485, 970]}
          sizes="(max-width: 1022px) 60vw, 485px"
          loading="eager"
          fetchpriority="high"
        />
        <div class="art__question" aria-hidden="true">
          <img src="/figma/question.svg" alt="" />
        </div>
        <div class="art__exclamation" aria-hidden="true">
          <img src="/figma/exclamation.svg" alt="" />
        </div>
        <img class="art__burst" src="/figma/burst.svg" alt="" aria-hidden="true" />
        <p class="art__burst-text">Нічого складного, лише робочі рішення!</p>
      </div>

      <div class="socials">
        <img src="/figma/socials.svg" alt="" width="42" height="332" aria-hidden="true" />
        {
          socials.map((s) =>
            s.href ? (
              <a
                class="socials__hit"
                style={`--t:${s.top}`}
                href={s.href}
                target={s.href.startsWith('http') ? '_blank' : undefined}
                rel={s.href.startsWith('http') ? 'noopener' : undefined}
                title={s.name}
              >
                <span class="visually-hidden">{s.name}</span>
              </a>
            ) : (
              <span class="visually-hidden">{s.name}</span>
            )
          )
        }
      </div>
    </div>
  </div>

  <ul class="process" aria-label="Що я роблю">
    <li class="process__dot" aria-hidden="true">•</li>
    {
      processSteps.map((step) => (
        <>
          <li class="process__step">{step}</li>
          <li class="process__dot" aria-hidden="true">•</li>
        </>
      ))
    }
  </ul>

  <!-- Горизонтальний ряд соцмереж під рядком навичок (показується лише на 768–1022px) -->
  <ul class="socials-row" aria-label="Месенджери й соцмережі">
    {
      socials.map((s) => (
        <li>
          <a
            class="socials-row__link"
            href={s.href || undefined}
            target={s.href.startsWith('http') ? '_blank' : undefined}
            rel={s.href.startsWith('http') ? 'noopener' : undefined}
            title={s.name}
          >
            <img src="/figma/socials.svg" alt="" width="42" height="332" style={`top:-${s.top}px`} />
            <span class="visually-hidden">{s.name}</span>
          </a>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .first-screen {
    /* 1 одиниця макета 1920px — для фонових кіл */
    --u: calc(100vw / 1920);
    /* Масштаб ілюстрації з фото: 1px на 1920, менше на вужчих екранах */
    --a: min(1px, max(0.45px, calc((100vw - 820px) / 712)));

    position: relative;
    overflow: hidden;
    padding-bottom: max(48px, calc(235 * var(--u)));
  }

  /* ---------- Фонові кола ---------- */
  .first-screen__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .bg-ellipse {
    position: absolute;
  }

  .bg-ellipse--left {
    left: calc(-222 * var(--u));
    top: calc(-51 * var(--u));
    width: calc(1000 * var(--u));
    height: calc(1008 * var(--u));
  }

  .bg-ellipse--top {
    left: calc(635 * var(--u));
    top: calc(-568 * var(--u));
    width: calc(740 * var(--u));
    height: calc(760 * var(--u));
  }

  .bg-ellipse--right {
    left: calc(1005 * var(--u));
    top: calc(115 * var(--u));
    width: calc(941 * var(--u));
    height: calc(941 * var(--u));
  }

  /* ---------- Основний ряд ---------- */
  /* .hero навмисно без position: іконки месенджерів на десктопі
     позиціонуються від усього першого екрана, як у макеті */
  .hero {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: calc(1496px + 2 * var(--page-gutter));
    margin: 81px auto 0;
    padding-inline: var(--page-gutter);
  }

  .hero__intro {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 96px;
    width: 566px;
    flex-shrink: 0;
  }

  .hero__copy {
    display: flex;
    flex-direction: column;
    gap: 32px;
    max-width: 495px;
  }

  .hero__eyebrow {
    margin: 0;
    font-size: 16px;
    font-weight: 400;
    text-transform: uppercase;
  }

  .hero__title {
    margin: 0;
    font-size: 64px;
    font-weight: 800;
    line-height: 64px;
  }

  /* примусовий перенос перед «разом» вмикається лише на 768–1022px */
  .lead-br {
    display: none;
  }

  .hero__lead {
    margin: 0;
    font-size: 18px;
    font-weight: 600;
    line-height: 28px;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 24px;
  }

  /* ---------- Ілюстрація: коло, фото, «?!», вибух ---------- */
  .hero__art-col {
    flex-shrink: 0;
  }

  .art {
    position: relative;
    width: calc(712 * var(--a));
    height: calc(587 * var(--a));
  }

  .art > * {
    position: absolute;
  }

  .art__circle {
    left: calc(124.93 * var(--a));
    top: 0;
    width: calc(587 * var(--a));
    height: calc(587 * var(--a));
  }

  .art__portrait {
    left: 0;
    top: calc(50.94 * var(--a));
    width: calc(485 * var(--a));
    height: calc(536 * var(--a));
    border-radius: calc(34 * var(--a));
    object-fit: cover;
    object-position: top;
  }

  .art__question,
  .art__exclamation {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .art__question {
    left: calc(338.98 * var(--a));
    top: calc(-57.96 * var(--a));
    width: calc(279.16 * var(--a));
    height: calc(315.2 * var(--a));
  }

  .art__question img {
    flex: none;
    width: calc(218.495 * var(--a));
    height: calc(268.812 * var(--a));
    transform: rotate(-14.59deg);
  }

  .art__exclamation {
    left: calc(483.9 * var(--a));
    top: calc(25 * var(--a));
    width: calc(180.3 * var(--a));
    height: calc(274.8 * var(--a));
  }

  .art__exclamation img {
    flex: none;
    width: calc(146.856 * var(--a));
    height: calc(257.421 * var(--a));
    transform: rotate(7.75deg);
  }

  .art__burst {
    left: calc(-249 * var(--a));
    top: calc(380 * var(--a));
    width: calc(367.5 * var(--a));
    height: calc(271.5 * var(--a));
  }

  .art__burst-text {
    left: calc(-185 * var(--a));
    top: calc(472 * var(--a));
    width: calc(213 * var(--a));
    margin: 0;
    font-size: max(10px, calc(20 * var(--a)));
    font-weight: 600;
    line-height: max(13px, calc(28 * var(--a)));
    text-align: center;
  }

  /* ---------- Іконки месенджерів ---------- */
  .socials {
    position: absolute;
    z-index: 1;
    right: var(--page-gutter);
    top: 262px;
    width: 42px;
    height: 332px;
  }

  .socials__hit {
    position: absolute;
    left: 0;
    top: calc(var(--t) * 1px);
    width: 42px;
    height: 42px;
    border-radius: 50%;
    transition: transform 0.2s ease;
  }

  .socials__hit:hover {
    background: rgb(255 255 255 / 0.2);
  }

  /* ---------- Горизонтальний ряд соцмереж (лише 768–1022px, див. нижче) ---------- */
  .socials-row {
    display: none;
  }

  .socials-row__link {
    position: relative;
    display: block;
    width: 42px;
    height: 42px;
    overflow: hidden;
    border-radius: 50%;
  }

  .socials-row__link img {
    position: absolute;
    left: 0;
  }

  /* ---------- Рядок навичок ---------- */
  .process {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 24px;
    margin: 85px 0 0;
    padding: 0 calc(2 * var(--page-gutter));
    list-style: none;
    text-transform: uppercase;
  }

  .process__dot {
    font-size: 18px;
    font-weight: 300;
  }

  .process__step {
    font-size: 16px;
    font-weight: 400;
    white-space: nowrap;
  }

  /* Від 1920 і вужче (до 1101) весь перший екран масштабується пропорційно
     макету: --k = ширина вікна / 1920. Жодних стрибків на 1800/1801. */
  @media (min-width: 1023px) and (max-width: 1920px) {
    .first-screen {
      --k: calc(100vw / 1920);
      --a: var(--k);
    }

    .hero {
      max-width: calc(1496 * var(--k) + 2 * var(--page-gutter));
      margin-top: calc(81 * var(--k));
    }

    .hero__intro {
      width: calc(566 * var(--k));
      gap: calc(96 * var(--k));
    }

    .hero__copy {
      gap: calc(32 * var(--k));
      max-width: calc(495 * var(--k));
    }

    .hero__eyebrow {
      font-size: max(12px, calc(16 * var(--k)));
    }

    .hero__title {
      font-size: max(40px, calc(64 * var(--k)));
      line-height: max(44px, calc(64 * var(--k)));
    }

    .hero__lead {
      font-size: max(14px, calc(18 * var(--k)));
      line-height: max(21px, calc(28 * var(--k)));
    }

    /* кнопки масштабуються разом з колонкою й не виходять за її межі */
    .hero__actions {
      gap: max(10px, calc(24 * var(--k)));
    }

    .hero__actions .btn {
      gap: max(6px, calc(12 * var(--k)));
      padding: max(8px, calc(12 * var(--k)));
      font-size: max(12px, calc(14 * var(--k)));
    }

    .hero__actions .btn__icon {
      width: max(20px, calc(32 * var(--k)));
      height: max(20px, calc(32 * var(--k)));
    }

    .socials {
      top: calc(262 * var(--k));
      width: calc(42 * var(--k));
      height: calc(332 * var(--k));
    }

    .socials > img {
      width: 100%;
      height: 100%;
    }

    .socials__hit {
      width: calc(42 * var(--k));
      height: calc(42 * var(--k));
      top: calc(var(--t) * var(--k));
    }
  }

  /* Від 1399 і вужче кнопки стоять стовпчиком, тому лівий еліпс (під ними)
     підлаштовуємо так, щоб від кутів кнопок до його краю лишалось ~55px
     (виміряно на 1101/1200/1300/1399: потрібна ширина 656/664/688/720px). */
  @media (min-width: 1023px) and (max-width: 1100px) {
    /* від 1100 еліпс і кнопки зменшуються пропорційно ширині екрана (657px на 1101) */
    .bg-ellipse--left {
      --w: calc(657px * 100vw / 1101px);
      width: var(--w);
      height: calc(var(--w) * 1.008);
    }

    .hero__actions .btn {
      gap: calc(6px * 100vw / 1101px);
      padding: calc(8px * 100vw / 1101px);
      font-size: calc(12px * 100vw / 1101px);
    }

    .hero__actions .btn__icon {
      width: calc(20px * 100vw / 1101px);
      height: calc(20px * 100vw / 1101px);
    }
  }

  @media (min-width: 1101px) and (max-width: 1399px) {
    .bg-ellipse--left {
      --w: calc(420px + 21.5vw);
      width: var(--w);
      height: calc(var(--w) * 1.008);
    }
  }

  /* Лівий еліпс на 1023–1200 збільшений (під кнопки), тому верхній і правий
     відсуваємо, щоб між усіма еліпсами лишалось не менше 30px.
     Верхній іде вправо-вгору (по лінії від лівого), правий — вправо. */
  @media (min-width: 1023px) and (max-width: 1210px) {
    .bg-ellipse--top {
      left: calc(635 * var(--u) + 0.1888 * (1210px - 100vw));
      top: calc(-568 * var(--u) - 0.256 * (1210px - 100vw));
    }

    .bg-ellipse--right {
      left: calc(1005 * var(--u) + max(0px, 1095px - 100vw));
    }
  }

  /* 1088–1023: заголовок зменшується разом з колонкою (шрифт ≈ 3.65vw),
     щоб лишатись у три рядки; на 1089 це рівно 40px */
  @media (min-width: 1023px) and (max-width: 1088px) {
    .hero__title {
      font-size: 3.65vw;
      line-height: 4.015vw;
    }
  }

  /* Від 1386 і вужче рядок навичок зменшується пропорційно ширині,
     щоб лишатись в один рядок (на 1387 він займає рівно доступну ширину) */
  @media (min-width: 1023px) and (max-width: 1386px) {
    .process {
      gap: 12px calc(24 * (100vw - 240px) / 1148);
    }

    .process__step {
      font-size: calc(16 * (100vw - 240px) / 1148);
    }

    .process__dot {
      font-size: calc(18 * (100vw - 240px) / 1148);
    }
  }

  /* Від 1399 і вужче: кнопки одна під одною, однакової ширини
     (контейнер за шириною ширшої кнопки, обидві розтягуються на нього) */
  @media (max-width: 1399px) {
    .hero__actions {
      flex-direction: column;
      align-items: stretch;
      width: fit-content;
    }
  }

  /* ---------- Планшет і телефон: колонка ---------- */
  @media (max-width: 1022px) {
    .first-screen {
      --a: min(0.9px, calc((100vw - 2 * var(--page-gutter) - 58px) / 961));
    }

    .hero {
      flex-direction: column;
      align-items: stretch;
      gap: 48px;
      margin-top: 48px;
    }

    .hero__intro {
      width: auto;
      max-width: 566px;
      gap: 48px;
    }

    .hero__art-col {
      position: relative;
      align-self: center;
      padding-right: 58px;
      /* колонка іконок (332px) вища за ілюстрацію на вузьких екранах */
      min-height: calc(58 * var(--a) + 332px);
    }

    .art {
      margin-left: calc(249 * var(--a));
      margin-top: calc(58 * var(--a));
    }

    .socials {
      right: 0;
      top: calc(58 * var(--a));
    }

    .process {
      justify-content: center;
      margin-top: 56px;
      padding-inline: var(--page-gutter);
    }

    .process__step {
      font-size: 14px;
    }
  }

  /* 768–1022: заголовок має той самий розмір, що на 1030px (3.65vw ≈ 37.6px) */
  @media (min-width: 768px) and (max-width: 1022px) {
    .hero__title {
      font-size: 37.6px;
      line-height: 41.4px;
    }

    /* абзац під заголовком — як на 1030px (мінімум 14px / 21px) */
    .hero__lead {
      font-size: 14px;
      line-height: 21px;
      /* ширина підібрана так, щоб абзац займав 4 рядки */
      max-width: 330px;
    }

    /* «разом, крок за кроком.» — в останньому рядку */
    .lead-br {
      display: inline;
    }

    /* Текст зліва, фото справа — як на 1023+. Фото зменшується за потреби:
       330 (текст) + 220a (проміжок) + 712a (фото) + 178 (поля й іконки) = 100vw */
    .first-screen {
      --a: calc((100vw - 508px) / 932);
    }

    .hero {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 0;
      padding-right: calc(var(--page-gutter) + 58px);
    }

    .hero__intro {
      max-width: none;
      flex-shrink: 0;
    }

    .hero__art-col {
      align-self: center;
      padding-right: 0;
      min-height: 0;
    }

    .art {
      margin: 0;
    }

    /* вертикальна колонка іконок ховається; замість неї — горизонтальний ряд під навичками */
    .socials {
      display: none;
    }

    .hero {
      padding-right: var(--page-gutter);
    }

    .first-screen {
      --a: calc((100vw - 450px) / 932);
    }

    .socials-row {
      position: relative;
      z-index: 1;
      display: flex;
      justify-content: center;
      gap: 24px;
      margin: 32px 0 0;
      padding: 0;
      list-style: none;
    }
  }

  @media (max-width: 600px) {
    .hero__title {
      font-size: 40px;
      line-height: 44px;
    }

    .hero__lead {
      font-size: 16px;
      line-height: 24px;
    }

    .hero__actions {
      gap: 12px;
    }
  }
</style>
